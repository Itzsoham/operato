# Operato — environment variables
#
# Copy to `.env` and fill in. NEVER commit `.env`.
# Only NEXT_PUBLIC_* values reach the browser — never put a secret behind that prefix.
# Full context for each block: docs/stack-changes.md

# ── Database (Neon Postgres) ────────────────────────────────────────────────
# App connection — full read/write, used by the main PrismaClient. Use Neon's
# POOLED endpoint (the host containing `-pooler`).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require&pgbouncer=true"

# Direct (unpooled) endpoint — the same host with `-pooler` removed. Prisma Migrate
# needs a real session rather than a pgbouncer transaction, so `directUrl` in
# schema.prisma and the datasource in prisma.config.ts both point here.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# AI connection — a DEDICATED READ-ONLY Postgres role, used by a SEPARATE
# PrismaClient for the text-to-SQL path only. This is a security boundary, not
# a convenience: it is what makes a model-generated write impossible rather
# than merely unlikely. See docs/plan-code-review.md §"read-only role".
DATABASE_URL_AI="postgresql://operato_ai_ro:PASSWORD@HOST-pooler/DB?sslmode=require&pgbouncer=true"

# ── Better Auth ─────────────────────────────────────────────────────────────
# >= 32 chars. Generate: openssl rand -base64 32
# Rotating this invalidates every existing session.
BETTER_AUTH_SECRET=""
# Must match the deployed origin in production, or OAuth callbacks + cookie
# domains break.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Optional Google social sign-in (only if enabled in src/lib/auth.ts)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Razorpay (billing) ──────────────────────────────────────────────────────
# Server-only.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET=""
# NOTE: the webhook secret is a value YOU choose in Dashboard → Settings →
# Webhooks. It is NOT the key secret. Mixing them up is the classic bug.
RAZORPAY_WEBHOOK_SECRET=""
# The shared "Operato Pro" plan id, created once per environment.
RAZORPAY_PRO_PLAN_ID="plan_xxxxxxxxxxxxxx"

# Client-safe: the Key ID is public by design (Checkout.js needs it).
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"

# ── Google Gemini (AI, via the Vercel AI SDK) ───────────────────────────────
# The @ai-sdk/google provider reads this name specifically — don't rename it.
GOOGLE_GENERATIVE_AI_API_KEY=""

# Per-tenant cap on interactive /ai/query questions, over a ROLLING 24h window.
# Optional; defaults to DEFAULT_DAILY_QUERIES_PER_TENANT in src/lib/ai/models.ts.
#
# The free tier is metered per Google Cloud PROJECT, not per key, so every tenant
# plus the weekly cron draws on ONE bucket. One interactive question costs TWO
# Gemini calls (SQL generation, then the prose answer). Raise this only once the
# key is billed — and re-check the live limits, which Google has cut more than
# once: https://ai.google.dev/gemini-api/docs/rate-limits
AI_DAILY_QUERY_LIMIT="25"

# ── Uploadthing (menu/catalog images) ───────────────────────────────────────
# v7 (installed): a SINGLE base64-encoded token carrying { apiKey, appId, regions }.
# Dashboard → API Keys → "API Key" (NOT the old v6 pair of UPLOADTHING_SECRET +
# UPLOADTHING_APP_ID — v7 folds both into this one value). No second var needed.
# Left unset in dev/CI is fine: src/app/api/uploadthing/core.ts fails per-request with
# a clear "Missing token" error rather than crashing at build or boot.
UPLOADTHING_TOKEN=""

# ── Vercel Cron (weekly summary) ────────────────────────────────────────────
# The cron route must reject any request whose Authorization header doesn't
# carry this. An unprotected cron route is a public endpoint.
CRON_SECRET=""
