# Operato — Environment Variables Example
# Copy this to .env (for local dev) or configure in your deployment platform (e.g. Vercel).

# ── Database (Neon Postgres) ────────────────────────────────────────────────
# App connection — pooled endpoint, full read/write, used by the main PrismaClient.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Direct (unpooled) endpoint — same host without `-pooler`. Used for Prisma Migrate and seeding.
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# AI connection — the DEDICATED READ-ONLY role, used for the text-to-SQL path only.
DATABASE_URL_AI="postgresql://operato_ai_ro:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# ── Better Auth ─────────────────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET="your-32-char-random-secret"
BETTER_AUTH_URL="https://your-production-domain.com"
NEXT_PUBLIC_BETTER_AUTH_URL="https://your-production-domain.com"

# Optional Google social sign-in (GCP OAuth Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Razorpay (Subscriptions & Billing) ──────────────────────────────────────
# dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
# Webhook secret set in Razorpay Dashboard -> Webhooks
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"
# Subscription plan ID created in Razorpay Dashboard
RAZORPAY_PRO_PLAN_ID="plan_xxxxxxxxxxxx"

# ── Google Gemini AI (Primary) ──────────────────────────────────────────────
# aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
GEMINI_MODEL_CRON="gemini-flash-lite-latest"

# ── OpenRouter AI (Fallback) ────────────────────────────────────────────────
# openrouter.ai/keys
OPEN_ROUTER_AI_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.5-flash"
OPENROUTER_MODEL_CRON="google/gemini-2.5-flash-lite"

# Per-tenant daily AI question rate limit (optional, defaults to 25)
AI_DAILY_QUERY_LIMIT="25"

# ── Uploadthing (Catalog & Menu Images) ─────────────────────────────────────
# uploadthing.com → Dashboard → API Keys
UPLOADTHING_TOKEN=""

# ── Vercel Cron (Weekly Summaries & Reconcile) ──────────────────────────────
# Random 32+ char secret for securing cron endpoints via Authorization Bearer
CRON_SECRET="your-cron-secret-token"
